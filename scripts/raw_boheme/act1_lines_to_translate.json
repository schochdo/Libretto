[
  {
    "cue_index": 1,
    "speaker": "Marcello",
    "direction": "seduto, continuando a dipingere; Si allontana dal cavalletto per guardare il suo quadro.; Torna al lavoro. A Rodolfo:",
    "lines": [
      "Questo Mar Rosso - mi ammollisce e assidera",
      "come se addosso - mi piovesse in stille.",
      "Per vendicarmi, affogo un Faraon!",
      "Che fai?"
    ]
  },
  {
    "cue_index": 2,
    "speaker": "Rodolfo",
    "direction": "volgendosi un poco; additando il camino senza fuoco",
    "lines": [
      "Nei cieli bigi",
      "guardo fumar dai mille",
      "comignoli Parigi",
      "e penso a quel poltrone",
      "di un vecchio caminetto ingannatore",
      "che vive in ozio come un gran signore."
    ]
  },
  {
    "cue_index": 3,
    "speaker": "Marcello",
    "direction": null,
    "lines": [
      "Le sue rendite oneste",
      "da un pezzo non riceve."
    ]
  },
  {
    "cue_index": 4,
    "speaker": "Rodolfo",
    "direction": null,
    "lines": [
      "Quelle sciocche foreste",
      "che fan sotto la neve?"
    ]
  },
  {
    "cue_index": 5,
    "speaker": "Marcello",
    "direction": null,
    "lines": [
      "Rodolfo, io voglio dirti un mio pensier profondo:",
      "ho un freddo cane."
    ]
  },
  {
    "cue_index": 6,
    "speaker": "Rodolfo",
    "direction": "avvicinandosi a Marcello",
    "lines": [
      "Ed io, Marcel, non ti nascondo",
      "che non credo al sudore della fronte."
    ]
  },
  {
    "cue_index": 7,
    "speaker": "Marcello",
    "direction": "Lascia sfuggire un lungo sospirone, e tralascia di dipingere, deponendo tavolozza e pennelli.",
    "lines": [
      "Ho diacciate",
      "le dita quasi ancora le tenessi immollate",
      "giù in quella gran ghiacciaia che è il cuore di Musetta..."
    ]
  },
  {
    "cue_index": 8,
    "speaker": "Rodolfo",
    "direction": null,
    "lines": [
      "L'amore è un caminetto che sciupa troppo..."
    ]
  },
  {
    "cue_index": 9,
    "speaker": "Marcello",
    "direction": null,
    "lines": [
      "... e in fretta!"
    ]
  },
  {
    "cue_index": 10,
    "speaker": "Rodolfo",
    "direction": null,
    "lines": [
      "... dove l'uomo è fascina..."
    ]
  },
  {
    "cue_index": 11,
    "speaker": "Marcello",
    "direction": null,
    "lines": [
      "... e la donna è l'alare..."
    ]
  },
  {
    "cue_index": 12,
    "speaker": "Rodolfo",
    "direction": null,
    "lines": [
      "... l'una brucia in un soffio..."
    ]
  },
  {
    "cue_index": 13,
    "speaker": "Marcello",
    "direction": null,
    "lines": [
      "... e l'altro sta a guardare."
    ]
  },
  {
    "cue_index": 14,
    "speaker": "Rodolfo",
    "direction": null,
    "lines": [
      "Ma intanto qui si gela..."
    ]
  },
  {
    "cue_index": 15,
    "speaker": "Marcello",
    "direction": null,
    "lines": [
      "... e si muore d'inedia!..."
    ]
  },
  {
    "cue_index": 16,
    "speaker": "Rodolfo",
    "direction": null,
    "lines": [
      "Fuoco ci vuole..."
    ]
  },
  {
    "cue_index": 17,
    "speaker": "Marcello",
    "direction": "afferrando una sedia e facendo atto di spezzarla; Rodolfo impedisce con energia l'atto di Marcello. Ad un tratto Rodolfo esce in un grido di gioia ad un'idea che gli è balenata.",
    "lines": [
      "Aspetta... sacrifichiam la sedia!"
    ]
  },
  {
    "cue_index": 18,
    "speaker": "Rodolfo",
    "direction": "Corre alla tavola e ne leva un voluminoso scartafaccio.",
    "lines": [
      "Eureka!"
    ]
  },
  {
    "cue_index": 19,
    "speaker": "Marcello",
    "direction": null,
    "lines": [
      "Trovasti?"
    ]
  },
  {
    "cue_index": 20,
    "speaker": "Rodolfo",
    "direction": null,
    "lines": [
      "Sì. Aguzza l'ingegno.",
      "L'idea vampi in fiamma."
    ]
  },
  {
    "cue_index": 21,
    "speaker": "Marcello",
    "direction": "additando il suo quadro",
    "lines": [
      "Bruciamo il Mar Rosso?"
    ]
  },
  {
    "cue_index": 22,
    "speaker": "Rodolfo",
    "direction": null,
    "lines": [
      "No. Puzza la tela dipinta. Il mio dramma,",
      "I'ardente mio dramma ci scaldi."
    ]
  },
  {
    "cue_index": 23,
    "speaker": "Marcello",
    "direction": "con comico spavento",
    "lines": [
      "Vuoi leggerlo forse? Mi geli."
    ]
  },
  {
    "cue_index": 24,
    "speaker": "Rodolfo",
    "direction": "con importanza",
    "lines": [
      "No, in cener la carta si sfaldi",
      "e l'estro rivoli ai suoi cieli.",
      "Al secol gran danno minaccia...",
      "E Roma in periglio..."
    ]
  },
  {
    "cue_index": 25,
    "speaker": "Marcello",
    "direction": "con esagerazione",
    "lines": [
      "Gran cor!"
    ]
  },
  {
    "cue_index": 26,
    "speaker": "Rodolfo",
    "direction": "Dà a Marcello una parte dello scartafaccio.",
    "lines": [
      "A te l'atto primo."
    ]
  },
  {
    "cue_index": 27,
    "speaker": "Marcello",
    "direction": null,
    "lines": [
      "Qua."
    ]
  },
  {
    "cue_index": 28,
    "speaker": "Rodolfo",
    "direction": null,
    "lines": [
      "Straccia."
    ]
  },
  {
    "cue_index": 29,
    "speaker": "Marcello",
    "direction": "Rodolfo batte un acciarino accende, una candela e va al camino con Marcello: insieme dànno fuoco a quella parte dello scartafaccio buttato sul focolare, poi entrambi prendono delle sedie e seggono, riscaldandosi voluttuosamente.",
    "lines": [
      "Accendi."
    ]
  },
  {
    "cue_index": 30,
    "speaker": "Rodolfo e Marcello",
    "direction": "Si apre con fracasso la porta in fondo ed entra Colline gelato, intirizzito, battendo i piedi, gettando con ira sulla tavola un pacco di libri legato con un fazzoletto.",
    "lines": [
      "Che lieto baglior!"
    ]
  },
  {
    "cue_index": 31,
    "speaker": "Colline",
    "direction": "Si interrompe sorpreso, vedendo fuoco nel caminetto.",
    "lines": [
      "Già dell'Apocalisse appariscono i segni.",
      "In giorno di vigilia non si accettano pegni!",
      "Una fiammata!"
    ]
  },
  {
    "cue_index": 32,
    "speaker": "Rodolfo",
    "direction": "a Colline",
    "lines": [
      "Zitto, si dà il mio dramma."
    ]
  },
  {
    "cue_index": 33,
    "speaker": "Marcello",
    "direction": null,
    "lines": [
      "... al fuoco."
    ]
  },
  {
    "cue_index": 34,
    "speaker": "Colline",
    "direction": null,
    "lines": [
      "Lo trovo scintillante."
    ]
  },
  {
    "cue_index": 35,
    "speaker": "Rodolfo",
    "direction": "Il fuoco diminuisce.",
    "lines": [
      "Vivo."
    ]
  },
  {
    "cue_index": 36,
    "speaker": "Colline",
    "direction": null,
    "lines": [
      "Ma dura poco."
    ]
  },
  {
    "cue_index": 37,
    "speaker": "Rodolfo",
    "direction": null,
    "lines": [
      "La brevità, gran pregio."
    ]
  },
  {
    "cue_index": 38,
    "speaker": "Colline",
    "direction": "levandogli la sedia",
    "lines": [
      "Autore, a me la sedia."
    ]
  },
  {
    "cue_index": 39,
    "speaker": "Marcello",
    "direction": null,
    "lines": [
      "Presto. Questi intermezzi fan morire d'inedia."
    ]
  },
  {
    "cue_index": 40,
    "speaker": "Rodolfo",
    "direction": "Prende un'altra parte dello scartafaccio.",
    "lines": [
      "Atto secondo."
    ]
  },
  {
    "cue_index": 41,
    "speaker": "Marcello",
    "direction": "a Colline; Rodolfo straccia parte dello scartafaccio e lo getta sul camino: il fuoco si ravviva. Colline avvicina ancora più la sedia e si riscalda le mani: Rodolfo è in piedi, presso ai due, col rimanente dello scartafaccio.",
    "lines": [
      "Non far sussurro."
    ]
  },
  {
    "cue_index": 42,
    "speaker": "Colline",
    "direction": null,
    "lines": [
      "Pensier profondo!"
    ]
  },
  {
    "cue_index": 43,
    "speaker": "Marcello",
    "direction": null,
    "lines": [
      "Giusto color!"
    ]
  },
  {
    "cue_index": 44,
    "speaker": "Rodolfo",
    "direction": null,
    "lines": [
      "In quell'azzurro - guizzo languente",
      "Sfuma un'ardente - scena d'amor."
    ]
  },
  {
    "cue_index": 45,
    "speaker": "Colline",
    "direction": null,
    "lines": [
      "Scoppietta un foglio."
    ]
  },
  {
    "cue_index": 46,
    "speaker": "Marcello",
    "direction": null,
    "lines": [
      "Là c'eran baci!"
    ]
  },
  {
    "cue_index": 47,
    "speaker": "Rodolfo",
    "direction": "Getta al fuoco il rimanente dello scartafaccio.",
    "lines": [
      "Tre atti or voglio - d'un colpo udir."
    ]
  },
  {
    "cue_index": 48,
    "speaker": "Colline",
    "direction": null,
    "lines": [
      "Tal degli audaci - I'idea s'integra."
    ]
  },
  {
    "cue_index": 49,
    "speaker": "Tutti",
    "direction": "Applaudono entusiasticamente: la fiamma dopo un momento diminuisce.",
    "lines": [
      "Bello in allegra - vampa svanir."
    ]
  },
  {
    "cue_index": 50,
    "speaker": "Marcello",
    "direction": null,
    "lines": [
      "Oh! Dio... già s'abbassa la fiamma."
    ]
  },
  {
    "cue_index": 51,
    "speaker": "Colline",
    "direction": null,
    "lines": [
      "Che vano, che fragile dramma!"
    ]
  },
  {
    "cue_index": 52,
    "speaker": "Marcello",
    "direction": null,
    "lines": [
      "Già scricchiola, increspasi, muore."
    ]
  },
  {
    "cue_index": 53,
    "speaker": "Colline e Marcello",
    "direction": "Il fuoco è spento.; Dalla porta di mezzo entrano due Garzoni, portando l'uno provviste di cibi, bottiglie di vino, sigari, e l'altro un fascio di legna. Al rumore, i tre innanzi al camino si volgono e con grida di meraviglia si slanciano sulle provviste portate dal garzone e le depongono sul tavolo. Colinne prende la legna e la porta presso il caminetto: comincia a far sera.",
    "lines": [
      "Abbasso, abbasso l'autore."
    ]
  },
  {
    "cue_index": 54,
    "speaker": "Rodolfo",
    "direction": null,
    "lines": [
      "Legna!"
    ]
  },
  {
    "cue_index": 55,
    "speaker": "Marcello",
    "direction": null,
    "lines": [
      "Sigari !"
    ]
  },
  {
    "cue_index": 56,
    "speaker": "Colline",
    "direction": null,
    "lines": [
      "Bordò!"
    ]
  },
  {
    "cue_index": 57,
    "speaker": "Tutti",
    "direction": "I garzoni partono.",
    "lines": [
      "Le dovizie d'una fiera",
      "il destin ci destinò."
    ]
  },
  {
    "cue_index": 58,
    "speaker": "Schaunard",
    "direction": "Entra dalla porta di mezzo con aria di trionfo, gettando a terra alcuni scudi.",
    "lines": [
      "La Banca di Francia",
      "per voi si sbilancia."
    ]
  },
  {
    "cue_index": 59,
    "speaker": "Colline",
    "direction": "raccattando gli scudi insieme a Rodolfo e Marcello",
    "lines": [
      "Raccatta, raccatta!"
    ]
  },
  {
    "cue_index": 60,
    "speaker": "Marcello",
    "direction": "incredulo",
    "lines": [
      "Son pezzi di latta!..."
    ]
  },
  {
    "cue_index": 61,
    "speaker": "Schaunard",
    "direction": "mostrandogli uno scudo",
    "lines": [
      "Sei sordo?... Sei lippo?",
      "Quest'uomo chi è?"
    ]
  },
  {
    "cue_index": 62,
    "speaker": "Rodolfo",
    "direction": "inchinandosi",
    "lines": [
      "Luigi Filippo!",
      "M'inchino al mio Re!"
    ]
  },
  {
    "cue_index": 63,
    "speaker": "Tutti",
    "direction": "Depongono gli scudi sul tavolo. Schaunard vorrebbe raccontare la sua fortuna, ma gli altri non lo ascoltano: vanno e vengono affaccendati disponendo ogni cosa sul tavolo.",
    "lines": [
      "Sta Luigi Filippo ai nostri pie'"
    ]
  },
  {
    "cue_index": 64,
    "speaker": "Schaunard",
    "direction": null,
    "lines": [
      "Or vi dirò: quest'oro, o meglio argento,",
      "ha la sua brava storia..."
    ]
  },
  {
    "cue_index": 65,
    "speaker": "Marcello",
    "direction": "ponendo la legna nel camino",
    "lines": [
      "Riscaldiamo",
      "il camino!"
    ]
  },
  {
    "cue_index": 66,
    "speaker": "Colline",
    "direction": null,
    "lines": [
      "Tanto freddo ha sofferto."
    ]
  },
  {
    "cue_index": 67,
    "speaker": "Schaunard",
    "direction": null,
    "lines": [
      "Un inglese... un signor... lord o milord",
      "che sia, voleva un musicista..."
    ]
  },
  {
    "cue_index": 68,
    "speaker": "Marcello",
    "direction": "gettando via il pacco di libri di Colline dal tavolo",
    "lines": [
      "Via!",
      "Prepariamo la tavola!"
    ]
  },
  {
    "cue_index": 69,
    "speaker": "Schaunard",
    "direction": null,
    "lines": [
      "Io? volo!"
    ]
  },
  {
    "cue_index": 70,
    "speaker": "Rodolfo",
    "direction": null,
    "lines": [
      "L'esca dov'è?"
    ]
  },
  {
    "cue_index": 71,
    "speaker": "Colline",
    "direction": null,
    "lines": [
      "Là."
    ]
  },
  {
    "cue_index": 72,
    "speaker": "Marcello",
    "direction": "Accendono un gran fuoco nel camino.",
    "lines": [
      "Qua."
    ]
  },
  {
    "cue_index": 73,
    "speaker": "Schaunard",
    "direction": null,
    "lines": [
      "E mi presento.",
      "M'accetta: gli domando..."
    ]
  },
  {
    "cue_index": 74,
    "speaker": "Colline",
    "direction": "mettendo a posto le vivande",
    "lines": [
      "Arrosto freddo!"
    ]
  },
  {
    "cue_index": 75,
    "speaker": "Marcello",
    "direction": "mentre Rodolfo accende l'altra candela",
    "lines": [
      "Pasticcio dolce!"
    ]
  },
  {
    "cue_index": 76,
    "speaker": "Schaunard",
    "direction": null,
    "lines": [
      "A quando le lezioni?...",
      "Risponde: \"Incominciam...",
      "Guardare!\" (e un pappagallo m'addita al primo piano),",
      "poi soggiunge: \"Voi suonare",
      "finché quello morire!\"."
    ]
  },
  {
    "cue_index": 77,
    "speaker": "Rodolfo",
    "direction": null,
    "lines": [
      "Fulgida folgori la sala splendida."
    ]
  },
  {
    "cue_index": 78,
    "speaker": "Marcello",
    "direction": "Mette le due candele sul tavolo",
    "lines": [
      "Or le candele!"
    ]
  },
  {
    "cue_index": 79,
    "speaker": "Schaunard",
    "direction": "Vedendo che nessuno gli bada, afferra Colline che gli passa vicino con un piatto.",
    "lines": [
      "E fu così:",
      "Suonai tre lunghi dì...",
      "Allora usai l'incanto",
      "di mia presenza bella...",
      "Affascinai l'ancella...",
      "Gli propinai prezzemolo!...",
      "Lorito allargò l'ali,",
      "Lorito il becco aprì,",
      "da Socrate morì!"
    ]
  },
  {
    "cue_index": 80,
    "speaker": "Colline",
    "direction": null,
    "lines": [
      "Pasticcio dolce!"
    ]
  },
  {
    "cue_index": 81,
    "speaker": "Marcello",
    "direction": null,
    "lines": [
      "Mangiar senza tovaglia?"
    ]
  },
  {
    "cue_index": 82,
    "speaker": "Rodolfo",
    "direction": "levando di tasca un giornale e spiegandolo",
    "lines": [
      "Un'idea..."
    ]
  },
  {
    "cue_index": 83,
    "speaker": "Colline e Marcello",
    "direction": null,
    "lines": [
      "Il \"Costituzional!\""
    ]
  },
  {
    "cue_index": 84,
    "speaker": "Rodolfo",
    "direction": null,
    "lines": [
      "Ottima carta...",
      "Si mangia e si divora un'appendice !"
    ]
  },
  {
    "cue_index": 85,
    "speaker": "Colline",
    "direction": null,
    "lines": [
      "Chi?!..."
    ]
  },
  {
    "cue_index": 86,
    "speaker": "Schaunard",
    "direction": "urlando indispettito; Poi, vedendoli in atto di mettersi a mangiare il pasticcio freddo:; Con gesto solenne stende la mano sul pasticcio ed impedisce agli amici di mangiarlo; poi leva le vivande dal tavolo e le mette nel piccolo armadio.",
    "lines": [
      "Che il diavolo vi porti tutti quanti!",
      "Ed or che fate?",
      "No! Queste cibarie",
      "sono la salmeria",
      "pei dì futuri",
      "tenebrosi e oscuri.",
      "Pranzare in casa",
      "il dì della vigilia",
      "mentre il Quartier Latino le sue vie",
      "addobba di salsicce e leccornie?",
      "Quando un olezzo di frittelle imbalsama",
      "le vecchie strade?"
    ]
  },
  {
    "cue_index": 87,
    "speaker": "Tutti",
    "direction": "Circondano ridendo Schaunard.",
    "lines": [
      "La vigilia di Natal!"
    ]
  },
  {
    "cue_index": 88,
    "speaker": "Schaunard",
    "direction": "Rodolfo chiude la porta a chiave, poi tutti vanno intorno al tavolo e versano il vino. Si bussa alla porta: s'arrestano stupefatti.",
    "lines": [
      "Là le ragazze cantano contente",
      "ed han per eco ognuna uno studente!",
      "Un po' di religione, o miei signori:",
      "si beva in casa, ma si pranzi fuori."
    ]
  },
  {
    "cue_index": 89,
    "speaker": "Benoît",
    "direction": "di fuori",
    "lines": [
      "Si può?"
    ]
  },
  {
    "cue_index": 90,
    "speaker": "Marcello",
    "direction": null,
    "lines": [
      "Chi è là?"
    ]
  },
  {
    "cue_index": 91,
    "speaker": "Benoît",
    "direction": null,
    "lines": [
      "Benoît!"
    ]
  },
  {
    "cue_index": 92,
    "speaker": "Marcello",
    "direction": "Depongono i bicchieri.",
    "lines": [
      "Il padrone di casa!"
    ]
  },
  {
    "cue_index": 93,
    "speaker": "Schaunard",
    "direction": null,
    "lines": [
      "Uscio sul muso."
    ]
  },
  {
    "cue_index": 94,
    "speaker": "Colline",
    "direction": "Grida:",
    "lines": [
      "Non c'è nessuno."
    ]
  },
  {
    "cue_index": 95,
    "speaker": "Schaunard",
    "direction": null,
    "lines": [
      "È chiuso."
    ]
  },
  {
    "cue_index": 96,
    "speaker": "Benoît",
    "direction": null,
    "lines": [
      "Una parola."
    ]
  },
  {
    "cue_index": 97,
    "speaker": "Schaunard",
    "direction": "Dopo essersi consultato cogli altri, va ad aprire.",
    "lines": [
      "Sola!"
    ]
  },
  {
    "cue_index": 98,
    "speaker": "Benoît",
    "direction": "Entra sorridente: vede Marcello e mostrandogli una carta dice:",
    "lines": [
      "Affitto !"
    ]
  },
  {
    "cue_index": 99,
    "speaker": "Marcello",
    "direction": "ricevendolo con grande cordialità",
    "lines": [
      "Olà !",
      "Date una sedia."
    ]
  },
  {
    "cue_index": 100,
    "speaker": "Rodolfo",
    "direction": null,
    "lines": [
      "Presto."
    ]
  },
  {
    "cue_index": 101,
    "speaker": "Benoît",
    "direction": "schermendosi",
    "lines": [
      "Non occorre. Vorrei..."
    ]
  },
  {
    "cue_index": 102,
    "speaker": "Schaunard",
    "direction": "Insistendo con dolce violenza, lo fa sedere.",
    "lines": [
      "Segga."
    ]
  },
  {
    "cue_index": 103,
    "speaker": "Marcello",
    "direction": "Gli versa del vino .",
    "lines": [
      "Vuol bere?"
    ]
  },
