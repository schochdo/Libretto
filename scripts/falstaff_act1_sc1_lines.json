[
  {
    "speaker": "Dr. Caius",
    "original": "Falstaff!",
    "cue_id": "a1_s1_c1",
    "line_id": "a1_s1_c1_l1"
  },
  {
    "speaker": "Sir John Falstaff",
    "original": "Olà!",
    "cue_id": "a1_s1_c2",
    "line_id": "a1_s1_c2_l1"
  },
  {
    "speaker": "Dr. Caius",
    "original": "Sir John Falstaff!",
    "cue_id": "a1_s1_c3",
    "line_id": "a1_s1_c3_l1"
  },
  {
    "speaker": "Bardolfo",
    "original": "Oh! che vi piglia?",
    "cue_id": "a1_s1_c4",
    "line_id": "a1_s1_c4_l1"
  },
  {
    "speaker": "Dr. Caius",
    "original": "Hai battuto i miei servi!...",
    "cue_id": "a1_s1_c5",
    "line_id": "a1_s1_c5_l1"
  },
  {
    "speaker": "Sir John Falstaff",
    "original": "Oste! un'altra bottiglia di Xeres.",
    "cue_id": "a1_s1_c6",
    "line_id": "a1_s1_c6_l1"
  },
  {
    "speaker": "Dr. Caius",
    "original": "Hai fiaccata la mia giumenta baia,",
    "cue_id": "a1_s1_c7",
    "line_id": "a1_s1_c7_l1"
  },
  {
    "speaker": "Dr. Caius",
    "original": "sforzata la mia casa.",
    "cue_id": "a1_s1_c7",
    "line_id": "a1_s1_c7_l2"
  },
  {
    "speaker": "Sir John Falstaff",
    "original": "Ma non la tua massaia.",
    "cue_id": "a1_s1_c8",
    "line_id": "a1_s1_c8_l1"
  },
  {
    "speaker": "Dr. Caius",
    "original": "Troppa grazia! Una vecchia cisposa. Ampio messere,",
    "cue_id": "a1_s1_c9",
    "line_id": "a1_s1_c9_l1"
  },
  {
    "speaker": "Dr. Caius",
    "original": "se foste venti volte John Falstaff cavaliere,",
    "cue_id": "a1_s1_c9",
    "line_id": "a1_s1_c9_l2"
  },
  {
    "speaker": "Dr. Caius",
    "original": "v'obbligherò a rispondermi.",
    "cue_id": "a1_s1_c9",
    "line_id": "a1_s1_c9_l3"
  },
  {
    "speaker": "Sir John Falstaff",
    "original": "Ecco la mia risposta:",
    "cue_id": "a1_s1_c10",
    "line_id": "a1_s1_c10_l1"
  },
  {
    "speaker": "Sir John Falstaff",
    "original": "ho fatto ciò che hai detto.",
    "cue_id": "a1_s1_c10",
    "line_id": "a1_s1_c10_l2"
  },
  {
    "speaker": "Dr. Caius",
    "original": "E poi?",
    "cue_id": "a1_s1_c11",
    "line_id": "a1_s1_c11_l1"
  },
  {
    "speaker": "Sir John Falstaff",
    "original": "L'ho fatto apposta.",
    "cue_id": "a1_s1_c12",
    "line_id": "a1_s1_c12_l1"
  },
  {
    "speaker": "Dr. Caius",
    "original": "M'appellerò al consiglio real.",
    "cue_id": "a1_s1_c13",
    "line_id": "a1_s1_c13_l1"
  },
  {
    "speaker": "Sir John Falstaff",
    "original": "Vatti con dio.",
    "cue_id": "a1_s1_c14",
    "line_id": "a1_s1_c14_l1"
  },
  {
    "speaker": "Sir John Falstaff",
    "original": "Sta' zitto o avrai le beffe; quest'è il consiglio mio.",
    "cue_id": "a1_s1_c14",
    "line_id": "a1_s1_c14_l2"
  },
  {
    "speaker": "Dr. Caius",
    "original": "Non è finita!",
    "cue_id": "a1_s1_c15",
    "line_id": "a1_s1_c15_l1"
  },
  {
    "speaker": "Sir John Falstaff",
    "original": "Al diavolo!",
    "cue_id": "a1_s1_c16",
    "line_id": "a1_s1_c16_l1"
  },
  {
    "speaker": "Dr. Caius",
    "original": "Bardolfo!",
    "cue_id": "a1_s1_c17",
    "line_id": "a1_s1_c17_l1"
  },
  {
    "speaker": "Bardolfo",
    "original": "Ser Dottore.",
    "cue_id": "a1_s1_c18",
    "line_id": "a1_s1_c18_l1"
  },
  {
    "speaker": "Dr. Caius",
    "original": "Tu, ier, m'hai fatto bere.",
    "cue_id": "a1_s1_c19",
    "line_id": "a1_s1_c19_l1"
  },
  {
    "speaker": "Bardolfo",
    "original": "Pur troppo! e che dolore!...",
    "cue_id": "a1_s1_c20",
    "line_id": "a1_s1_c20_l1"
  },
  {
    "speaker": "Bardolfo",
    "original": "Sto mal. D'un tuo pronostico m'assisti. Ho l'intestino",
    "cue_id": "a1_s1_c21",
    "line_id": "a1_s1_c21_l1"
  },
  {
    "speaker": "Bardolfo",
    "original": "guasto. Malanno agli osti che dan la calce al vino!",
    "cue_id": "a1_s1_c21",
    "line_id": "a1_s1_c21_l2"
  },
  {
    "speaker": "Bardolfo",
    "original": "Vedi questa meteora?",
    "cue_id": "a1_s1_c22",
    "line_id": "a1_s1_c22_l1"
  },
  {
    "speaker": "Dr. Caius",
    "original": "La vedo.",
    "cue_id": "a1_s1_c23",
    "line_id": "a1_s1_c23_l1"
  },
  {
    "speaker": "Bardolfo",
    "original": "Essa si corca",
    "cue_id": "a1_s1_c24",
    "line_id": "a1_s1_c24_l1"
  },
  {
    "speaker": "Bardolfo",
    "original": "rossa così ogni notte.",
    "cue_id": "a1_s1_c24",
    "line_id": "a1_s1_c24_l2"
  },
  {
    "speaker": "Dr. Caius",
    "original": "Pronostico di forca!",
    "cue_id": "a1_s1_c25",
    "line_id": "a1_s1_c25_l1"
  },
  {
    "speaker": "Dr. Caius",
    "original": "M'hai fatto ber, furfante, con lui, narrando frasche;",
    "cue_id": "a1_s1_c26",
    "line_id": "a1_s1_c26_l1"
  },
  {
    "speaker": "Dr. Caius",
    "original": "poi, quando fui ben ciùschero, m'hai vuotato le tasche.",
    "cue_id": "a1_s1_c26",
    "line_id": "a1_s1_c26_l2"
  },
  {
    "speaker": "Bardolfo",
    "original": "Non io.",
    "cue_id": "a1_s1_c27",
    "line_id": "a1_s1_c27_l1"
  },
  {
    "speaker": "Dr. Caius",
    "original": "Chi fu?",
    "cue_id": "a1_s1_c28",
    "line_id": "a1_s1_c28_l1"
  },
  {
    "speaker": "Sir John Falstaff",
    "original": "Pistola!",
    "cue_id": "a1_s1_c29",
    "line_id": "a1_s1_c29_l1"
  },
  {
    "speaker": "Pistola",
    "original": "Padrone.",
    "cue_id": "a1_s1_c30",
    "line_id": "a1_s1_c30_l1"
  },
  {
    "speaker": "Sir John Falstaff",
    "original": "Hai tu vuotate",
    "cue_id": "a1_s1_c31",
    "line_id": "a1_s1_c31_l1"
  },
  {
    "speaker": "Sir John Falstaff",
    "original": "le tasche a quel messere?",
    "cue_id": "a1_s1_c31",
    "line_id": "a1_s1_c31_l2"
  },
  {
    "speaker": "Dr. Caius",
    "original": "Certo fu lui. Guardate.",
    "cue_id": "a1_s1_c32",
    "line_id": "a1_s1_c32_l1"
  },
  {
    "speaker": "Dr. Caius",
    "original": "Come s'atteggia al niego quel ceffo da bugiardo!",
    "cue_id": "a1_s1_c32",
    "line_id": "a1_s1_c32_l2"
  },
  {
    "speaker": "Dr. Caius",
    "original": "Qui c'eran due scellini del regno d'Edoardo",
    "cue_id": "a1_s1_c33",
    "line_id": "a1_s1_c33_l1"
  },
  {
    "speaker": "Dr. Caius",
    "original": "e sei mezzecorone.",
    "cue_id": "a1_s1_c33",
    "line_id": "a1_s1_c33_l2"
  },
  {
    "speaker": "Dr. Caius",
    "original": "Non ne riman più segno.",
    "cue_id": "a1_s1_c33",
    "line_id": "a1_s1_c33_l3"
  },
  {
    "speaker": "Pistola",
    "original": "Padron, chiedo di battermi con quest'arma di legno.",
    "cue_id": "a1_s1_c34",
    "line_id": "a1_s1_c34_l1"
  },
  {
    "speaker": "Pistola",
    "original": "Vi smentisco!",
    "cue_id": "a1_s1_c35",
    "line_id": "a1_s1_c35_l1"
  },
  {
    "speaker": "Dr. Caius",
    "original": "Bifolco! tu parli a un gentiluomo!",
    "cue_id": "a1_s1_c36",
    "line_id": "a1_s1_c36_l1"
  },
  {
    "speaker": "Pistola",
    "original": "Gonzo!",
    "cue_id": "a1_s1_c37",
    "line_id": "a1_s1_c37_l1"
  },
  {
    "speaker": "Dr. Caius",
    "original": "Pezzente!",
    "cue_id": "a1_s1_c38",
    "line_id": "a1_s1_c38_l1"
  },
  {
    "speaker": "Pistola",
    "original": "Bestia!",
    "cue_id": "a1_s1_c39",
    "line_id": "a1_s1_c39_l1"
  },
  {
    "speaker": "Dr. Caius",
    "original": "Can!",
    "cue_id": "a1_s1_c40",
    "line_id": "a1_s1_c40_l1"
  },
  {
    "speaker": "Pistola",
    "original": "Vil!",
    "cue_id": "a1_s1_c41",
    "line_id": "a1_s1_c41_l1"
  },
  {
    "speaker": "Dr. Caius",
    "original": "Spauracchio!",
    "cue_id": "a1_s1_c42",
    "line_id": "a1_s1_c42_l1"
  },
  {
    "speaker": "Pistola",
    "original": "Gnomo!",
    "cue_id": "a1_s1_c43",
    "line_id": "a1_s1_c43_l1"
  },
  {
    "speaker": "Dr. Caius",
    "original": "Germoglio di mandragora!",
    "cue_id": "a1_s1_c44",
    "line_id": "a1_s1_c44_l1"
  },
  {
    "speaker": "Pistola",
    "original": "Chi?",
    "cue_id": "a1_s1_c45",
    "line_id": "a1_s1_c45_l1"
  },
  {
    "speaker": "Dr. Caius",
    "original": "Tu.",
    "cue_id": "a1_s1_c46",
    "line_id": "a1_s1_c46_l1"
  },
  {
    "speaker": "Pistola",
    "original": "Ripeti!",
    "cue_id": "a1_s1_c47",
    "line_id": "a1_s1_c47_l1"
  },
  {
    "speaker": "Dr. Caius",
    "original": "Sì.",
    "cue_id": "a1_s1_c48",
    "line_id": "a1_s1_c48_l1"
  },
  {
    "speaker": "Pistola",
    "original": "Saette!",
    "cue_id": "a1_s1_c49",
    "line_id": "a1_s1_c49_l1"
  },
  {
    "speaker": "Sir John Falstaff",
    "original": "Ehi là! Pistola!",
    "cue_id": "a1_s1_c50",
    "line_id": "a1_s1_c50_l1"
  },
  {
    "speaker": "Sir John Falstaff",
    "original": "Non scaricarti qui!",
    "cue_id": "a1_s1_c51",
    "line_id": "a1_s1_c51_l1"
  },
  {
    "speaker": "Sir John Falstaff",
    "original": "Bardolfo! Chi ha vuotato le tasche a quel messere?",
    "cue_id": "a1_s1_c52",
    "line_id": "a1_s1_c52_l1"
  },
  {
    "speaker": "Dr. Caius",
    "original": "Fu l'un dei due.",
    "cue_id": "a1_s1_c53",
    "line_id": "a1_s1_c53_l1"
  },
  {
    "speaker": "Bardolfo",
    "original": "Costui beve, poi pe 'l gran bere",
    "cue_id": "a1_s1_c54",
    "line_id": "a1_s1_c54_l1"
  },
  {
    "speaker": "Bardolfo",
    "original": "perde i suoi cinque sensi, poi ti narra una favola",
    "cue_id": "a1_s1_c54",
    "line_id": "a1_s1_c54_l2"
  },
  {
    "speaker": "Bardolfo",
    "original": "ch'egli ha sognato mentre dormì sotto la tavola.",
    "cue_id": "a1_s1_c54",
    "line_id": "a1_s1_c54_l3"
  },
  {
    "speaker": "Sir John Falstaff",
    "original": "L'odi? Se ti capaciti, del ver tu sei sicuro.",
    "cue_id": "a1_s1_c55",
    "line_id": "a1_s1_c55_l1"
  },
  {
    "speaker": "Sir John Falstaff",
    "original": "I fatti son negati. Vattene in pace.",
    "cue_id": "a1_s1_c55",
    "line_id": "a1_s1_c55_l2"
  },
  {
    "speaker": "Dr. Caius",
    "original": "Giuro",
    "cue_id": "a1_s1_c56",
    "line_id": "a1_s1_c56_l1"
  },
  {
    "speaker": "Dr. Caius",
    "original": "che se mai mi ubriaco ancora all'osteria",
    "cue_id": "a1_s1_c56",
    "line_id": "a1_s1_c56_l2"
  },
  {
    "speaker": "Dr. Caius",
    "original": "sarà fra gente onesta, sobria, civile e pia.",
    "cue_id": "a1_s1_c56",
    "line_id": "a1_s1_c56_l3"
  },
  {
    "speaker": "Bardolfo & Pistola",
    "original": "Amen.",
    "cue_id": "a1_s1_c58",
    "line_id": "a1_s1_c58_l1"
  },
  {
    "speaker": "Sir John Falstaff",
    "original": "Cessi l'antifona. La urlate in contrattempo.",
    "cue_id": "a1_s1_c59",
    "line_id": "a1_s1_c59_l1"
  },
  {
    "speaker": "Sir John Falstaff",
    "original": "L'arte sta in questa massima: «rubar con garbo e a tempo».",
    "cue_id": "a1_s1_c61",
    "line_id": "a1_s1_c61_l1"
  },
  {
    "speaker": "Sir John Falstaff",
    "original": "Siete dei rozzi artisti.",
    "cue_id": "a1_s1_c61",
    "line_id": "a1_s1_c61_l2"
  },
  {
    "speaker": "Sir John Falstaff",
    "original": "«Sei polli: sei scellini,",
    "cue_id": "a1_s1_c62",
    "line_id": "a1_s1_c62_l1"
  },
  {
    "speaker": "Sir John Falstaff",
    "original": "trenta giarre di Xeres: due lire; tre tacchini...»",
    "cue_id": "a1_s1_c62",
    "line_id": "a1_s1_c62_l2"
  },
  {
    "speaker": "Sir John Falstaff",
    "original": "Fruga nella mia borsa.",
    "cue_id": "a1_s1_c63",
    "line_id": "a1_s1_c63_l1"
  },
  {
    "speaker": "Sir John Falstaff",
    "original": "«Due fagiani, un'acciuga.»",
    "cue_id": "a1_s1_c64",
    "line_id": "a1_s1_c64_l1"
  },
  {
    "speaker": "Bardolfo",
    "original": "Un mark, un mark, un penny.",
    "cue_id": "a1_s1_c65",
    "line_id": "a1_s1_c65_l1"
  },
  {
    "speaker": "Sir John Falstaff",
    "original": "Fruga.",
    "cue_id": "a1_s1_c66",
    "line_id": "a1_s1_c66_l1"
  },
  {
    "speaker": "Bardolfo",
    "original": "Ho frugato.",
    "cue_id": "a1_s1_c67",
    "line_id": "a1_s1_c67_l1"
  },
  {
    "speaker": "Sir John Falstaff",
    "original": "Fruga!",
    "cue_id": "a1_s1_c68",
    "line_id": "a1_s1_c68_l1"
  },
  {
    "speaker": "Bardolfo",
    "original": "Qui non c'è più uno spicciolo.",
    "cue_id": "a1_s1_c69",
    "line_id": "a1_s1_c69_l1"
  },
  {
    "speaker": "Sir John Falstaff",
    "original": "Sei la mia distruzione!",
    "cue_id": "a1_s1_c70",
    "line_id": "a1_s1_c70_l1"
  },
  {
    "speaker": "Sir John Falstaff",
    "original": "Spendo ogni sette giorni dieci ghinee! Beone!",
    "cue_id": "a1_s1_c70",
    "line_id": "a1_s1_c70_l2"
  },
  {
    "speaker": "Sir John Falstaff",
    "original": "So che se andiam, la notte, di taverna in taverna,",
    "cue_id": "a1_s1_c70",
    "line_id": "a1_s1_c70_l3"
  },
  {
    "speaker": "Sir John Falstaff",
    "original": "quel tuo naso ardentissimo mi serve da lanterna;",
    "cue_id": "a1_s1_c70",
    "line_id": "a1_s1_c70_l4"
  },
  {
    "speaker": "Sir John Falstaff",
    "original": "ma quel risparmio d'olio me lo consumi in vino.",
    "cue_id": "a1_s1_c70",
    "line_id": "a1_s1_c70_l5"
  },
  {
    "speaker": "Sir John Falstaff",
    "original": "Son trent'anni che abbevero quel fungo porporino!",
    "cue_id": "a1_s1_c70",
    "line_id": "a1_s1_c70_l6"
  },
  {
    "speaker": "Sir John Falstaff",
    "original": "Costi troppo.",
    "cue_id": "a1_s1_c70",
    "line_id": "a1_s1_c70_l7"
  },
  {
    "speaker": "Sir John Falstaff",
    "original": "E tu pure. Oste! un'altra bottiglia.",
    "cue_id": "a1_s1_c71",
    "line_id": "a1_s1_c71_l1"
  },
  {
    "speaker": "Sir John Falstaff",
    "original": "Mi struggete le carni! Se Falstaff s'assottiglia",
    "cue_id": "a1_s1_c72",
    "line_id": "a1_s1_c72_l1"
  },
  {
    "speaker": "Sir John Falstaff",
    "original": "non è più lui, nessuno più l'ama; in questo addome",
    "cue_id": "a1_s1_c72",
    "line_id": "a1_s1_c72_l2"
  },
  {
    "speaker": "Sir John Falstaff",
    "original": "c'è un migliaio di lingue che annunciano il mio nome!",
    "cue_id": "a1_s1_c72",
    "line_id": "a1_s1_c72_l3"
  },
  {
    "speaker": "Pistola",
    "original": "Falstaff immenso!",
    "cue_id": "a1_s1_c73",
    "line_id": "a1_s1_c73_l1"
  },
  {
    "speaker": "Bardolfo",
    "original": "Enorme Falstaff!",
    "cue_id": "a1_s1_c74",
    "line_id": "a1_s1_c74_l1"
  },
  {
    "speaker": "Sir John Falstaff",
    "original": "Quest'è il mio regno.",
    "cue_id": "a1_s1_c75",
    "line_id": "a1_s1_c75_l1"
  },
  {
    "speaker": "Sir John Falstaff",
    "original": "Lo ingrandirò. Ma è tempo d'assottigliar l'ingegno.",
    "cue_id": "a1_s1_c75",
    "line_id": "a1_s1_c75_l2"
  },
  {
    "speaker": "Sir John Falstaff",
    "original": "PISTOLA E BARDOLFO",
    "cue_id": "a1_s1_c75",
    "line_id": "a1_s1_c75_l3"
  },
  {
    "speaker": "Sir John Falstaff",
    "original": "Assottigliam.",
    "cue_id": "a1_s1_c75",
    "line_id": "a1_s1_c75_l4"
  },
  {
    "speaker": "Sir John Falstaff",
    "original": "V'è noto un tal, qui del paese,",
    "cue_id": "a1_s1_c77",
    "line_id": "a1_s1_c77_l1"
  },
  {
    "speaker": "Sir John Falstaff",
    "original": "che ha nome Ford?",
    "cue_id": "a1_s1_c77",
    "line_id": "a1_s1_c77_l2"
  },
  {
    "speaker": "Sir John Falstaff",
    "original": "Quell'uom è un gran borghese...",
    "cue_id": "a1_s1_c80",
    "line_id": "a1_s1_c80_l1"
  },
  {
    "speaker": "Pistola",
    "original": "Più liberal d'un Creso.",
    "cue_id": "a1_s1_c81",
    "line_id": "a1_s1_c81_l1"
  },
  {
    "speaker": "Bardolfo",
    "original": "È un Lord!",
    "cue_id": "a1_s1_c82",
    "line_id": "a1_s1_c82_l1"
  },
  {
    "speaker": "Sir John Falstaff",
    "original": "Sua moglie è bella.",
    "cue_id": "a1_s1_c83",
    "line_id": "a1_s1_c83_l1"
  },
  {
    "speaker": "Sir John Falstaff",
    "original": "Atto primo Falstaff",
    "cue_id": "a1_s1_c83",
    "line_id": "a1_s1_c83_l2"
  },
  {
    "speaker": "Pistola",
    "original": "E tien lo scrigno.",
    "cue_id": "a1_s1_c84",
    "line_id": "a1_s1_c84_l1"
  },
  {
    "speaker": "Sir John Falstaff",
    "original": "È quella! O amor! Sguardo di stella!",
    "cue_id": "a1_s1_c85",
    "line_id": "a1_s1_c85_l1"
  },
  {
    "speaker": "Sir John Falstaff",
    "original": "Collo di cigno! e il labbro? Un fior. Un fior che ride.",
    "cue_id": "a1_s1_c85",
    "line_id": "a1_s1_c85_l2"
  },
  {
    "speaker": "Sir John Falstaff",
    "original": "Alice è il nome, e un giorno, come passar mi vide",
    "cue_id": "a1_s1_c85",
    "line_id": "a1_s1_c85_l3"
  },
  {
    "speaker": "Sir John Falstaff",
    "original": "ne' suoi paraggi, rise. M'ardea l'estro amatorio",
    "cue_id": "a1_s1_c85",
    "line_id": "a1_s1_c85_l4"
  },
  {
    "speaker": "Sir John Falstaff",
    "original": "nel cor. La dèa vibrava raggi di specchio ustorio,",
    "cue_id": "a1_s1_c85",
    "line_id": "a1_s1_c85_l5"
  },
  {
    "speaker": "Sir John Falstaff",
    "original": "su me, su me, sul fianco baldo, sul gran torace,",
    "cue_id": "a1_s1_c86",
    "line_id": "a1_s1_c86_l1"
  },
  {
    "speaker": "Sir John Falstaff",
    "original": "sul maschio piè, sul fusto saldo, erto, capace;",
    "cue_id": "a1_s1_c86",
    "line_id": "a1_s1_c86_l2"
  },
  {
    "speaker": "Sir John Falstaff",
    "original": "e il suo desir in lei fulgea sì al mio congiunto",
    "cue_id": "a1_s1_c86",
    "line_id": "a1_s1_c86_l3"
  },
  {
    "speaker": "Sir John Falstaff",
    "original": "che parea dir: «Io son di Sir John Falstaff.»",
    "cue_id": "a1_s1_c86",
    "line_id": "a1_s1_c86_l4"
  },
  {
    "speaker": "Bardolfo",
    "original": "Punto.",
    "cue_id": "a1_s1_c87",
    "line_id": "a1_s1_c87_l1"
  },
  {
    "speaker": "Sir John Falstaff",
    "original": "E a capo. Un'altra; e questa ha nome Margherita.",
    "cue_id": "a1_s1_c88",
    "line_id": "a1_s1_c88_l1"
  },
  {
    "speaker": "Pistola",
    "original": "La chiaman Meg.",
    "cue_id": "a1_s1_c89",
    "line_id": "a1_s1_c89_l1"
  },
  {
    "speaker": "Sir John Falstaff",
    "original": "È anch'essa dei miei pregi invaghita.",
    "cue_id": "a1_s1_c90",
    "line_id": "a1_s1_c90_l1"
  },
  {
    "speaker": "Sir John Falstaff",
    "original": "E anch'essa tien le chiavi dello scrigno. Costoro",
    "cue_id": "a1_s1_c90",
    "line_id": "a1_s1_c90_l2"
  },
  {
    "speaker": "Sir John Falstaff",
    "original": "saran le mie Golconde e le mie Coste d'oro!",
    "cue_id": "a1_s1_c90",
    "line_id": "a1_s1_c90_l3"
  },
  {
    "speaker": "Sir John Falstaff",
    "original": "Guardate. Io sono ancora una piacente estate",
    "cue_id": "a1_s1_c90",
    "line_id": "a1_s1_c90_l4"
  },
  {
    "speaker": "Sir John Falstaff",
    "original": "di san Martino. A voi, due lettere infuocate.",
    "cue_id": "a1_s1_c90",
    "line_id": "a1_s1_c90_l5"
  },
  {
    "speaker": "Sir John Falstaff",
    "original": "Tu porta questa a Meg; tentiam la sua virtù.",
    "cue_id": "a1_s1_c91",
    "line_id": "a1_s1_c91_l1"
  },
  {
    "speaker": "Sir John Falstaff",
    "original": "Già vedo che il tuo naso arde di zelo.",
    "cue_id": "a1_s1_c92",
    "line_id": "a1_s1_c92_l1"
  },
  {
    "speaker": "Sir John Falstaff",
    "original": "E tu porta questa ad Alice.",
    "cue_id": "a1_s1_c93",
    "line_id": "a1_s1_c93_l1"
  },
  {
    "speaker": "Pistola",
    "original": "Porto una spada al fianco.",
    "cue_id": "a1_s1_c94",
    "line_id": "a1_s1_c94_l1"
  },
  {
    "speaker": "Pistola",
    "original": "Non sono un messer Pandarus. Ricuso.",
    "cue_id": "a1_s1_c94",
    "line_id": "a1_s1_c94_l2"
  },
  {
    "speaker": "Sir John Falstaff",
    "original": "Saltimbanco.",
    "cue_id": "a1_s1_c95",
    "line_id": "a1_s1_c95_l1"
  },
  {
    "speaker": "Bardolfo",
    "original": "Sir John, in questo intrigo non posso accondiscendervi,",
    "cue_id": "a1_s1_c96",
    "line_id": "a1_s1_c96_l1"
  },
  {
    "speaker": "Bardolfo",
    "original": "lo vieta...",
    "cue_id": "a1_s1_c96",
    "line_id": "a1_s1_c96_l2"
  },
  {
    "speaker": "Bardolfo",
    "original": "L'onore.",
    "cue_id": "a1_s1_c98",
    "line_id": "a1_s1_c98_l1"
  },
  {
    "speaker": "Sir John Falstaff",
    "original": "Ehi! paggio!",
    "cue_id": "a1_s1_c99",
    "line_id": "a1_s1_c99_l1"
  },
  {
    "speaker": "Sir John Falstaff",
    "original": "Andate a impendervi,",
    "cue_id": "a1_s1_c100",
    "line_id": "a1_s1_c100_l1"
  },
  {
    "speaker": "Sir John Falstaff",
    "original": "ma non più a me!",
    "cue_id": "a1_s1_c100",
    "line_id": "a1_s1_c100_l2"
  },
  {
    "speaker": "Sir John Falstaff",
    "original": "Due lettere, prendi, per due signore.",
    "cue_id": "a1_s1_c101",
    "line_id": "a1_s1_c101_l1"
  },
  {
    "speaker": "Sir John Falstaff",
    "original": "Consegna tosto, corri, via, lesto, va'!",
    "cue_id": "a1_s1_c101",
    "line_id": "a1_s1_c101_l2"
  },
  {
    "speaker": "Sir John Falstaff",
    "original": "L'onore!",
    "cue_id": "a1_s1_c102",
    "line_id": "a1_s1_c102_l1"
  },
  {
    "speaker": "Sir John Falstaff",
    "original": "Ladri! Voi state ligi all'onor vostro, voi!",
    "cue_id": "a1_s1_c102",
    "line_id": "a1_s1_c102_l2"
  },
  {
    "speaker": "Sir John Falstaff",
    "original": "Cloache d'ignominia, quando, non sempre, noi",
    "cue_id": "a1_s1_c102",
    "line_id": "a1_s1_c102_l3"
  },
  {
    "speaker": "Sir John Falstaff",
    "original": "possiam star ligi al nostro. Io stesso, sì, io, io,",
    "cue_id": "a1_s1_c102",
    "line_id": "a1_s1_c102_l4"
  },
  {
    "speaker": "Sir John Falstaff",
    "original": "devo talor da un lato porre il timor di dio",
    "cue_id": "a1_s1_c102",
    "line_id": "a1_s1_c102_l5"
  },
  {
    "speaker": "Sir John Falstaff",
    "original": "e, per necessità, sviar l'onore e usare",
    "cue_id": "a1_s1_c102",
    "line_id": "a1_s1_c102_l6"
  },
  {
    "speaker": "Sir John Falstaff",
    "original": "stratagemmi ed equivoci, destreggiar, bordeggiare.",
    "cue_id": "a1_s1_c102",
    "line_id": "a1_s1_c102_l7"
  },
  {
    "speaker": "Sir John Falstaff",
    "original": "E voi, coi vostri cenci e coll'occhiata torta",
    "cue_id": "a1_s1_c102",
    "line_id": "a1_s1_c102_l8"
  },
  {
    "speaker": "Sir John Falstaff",
    "original": "da gattopardo",
    "cue_id": "a1_s1_c102",
    "line_id": "a1_s1_c102_l9"
  },
  {
    "speaker": "Sir John Falstaff",
    "original": "e i fetidi sghignazzi, avete a scorta",
    "cue_id": "a1_s1_c102",
    "line_id": "a1_s1_c102_l10"
  },
  {
    "speaker": "Sir John Falstaff",
    "original": "il vostro onor! Che onore? che onor? che onor! che ciancia!",
    "cue_id": "a1_s1_c102",
    "line_id": "a1_s1_c102_l11"
  },
  {
    "speaker": "Sir John Falstaff",
    "original": "Che baia! Può l'onore riempirvi la pancia?",
    "cue_id": "a1_s1_c102",
    "line_id": "a1_s1_c102_l12"
  },
  {
    "speaker": "Sir John Falstaff",
    "original": "No. Può l'onor rimettervi uno stinco? Non può.",
    "cue_id": "a1_s1_c102",
    "line_id": "a1_s1_c102_l13"
  },
  {
    "speaker": "Sir John Falstaff",
    "original": "Né un piede? No. Né un dito? No. Né un capello? No.",
    "cue_id": "a1_s1_c102",
    "line_id": "a1_s1_c102_l14"
  },
  {
    "speaker": "Sir John Falstaff",
    "original": "L'onor non è chirurgo. Ch'è dunque? Una parola.",
    "cue_id": "a1_s1_c102",
    "line_id": "a1_s1_c102_l15"
  },
  {
    "speaker": "Sir John Falstaff",
    "original": "Che c'è in questa parola? C'è dell'aria che vola.",
    "cue_id": "a1_s1_c102",
    "line_id": "a1_s1_c102_l16"
  },
  {
    "speaker": "Sir John Falstaff",
    "original": "Bel costrutto! L'onore lo può sentire chi è morto?",
    "cue_id": "a1_s1_c102",
    "line_id": "a1_s1_c102_l17"
  },
  {
    "speaker": "Sir John Falstaff",
    "original": "No. Vive sol coi vivi?... Neppure: perché a torto",
    "cue_id": "a1_s1_c102",
    "line_id": "a1_s1_c102_l18"
  },
  {
    "speaker": "Sir John Falstaff",
    "original": "lo gonfian le lusinghe, lo corrompe l'orgoglio,",
    "cue_id": "a1_s1_c102",
    "line_id": "a1_s1_c102_l19"
  },
  {
    "speaker": "Sir John Falstaff",
    "original": "l'ammorban le calunnie; e per me non ne voglio!",
    "cue_id": "a1_s1_c102",
    "line_id": "a1_s1_c102_l20"
  },
  {
    "speaker": "Sir John Falstaff",
    "original": "Ma, per tornare a voi, furfanti, ho atteso troppo.",
    "cue_id": "a1_s1_c102",
    "line_id": "a1_s1_c102_l21"
  },
  {
    "speaker": "Sir John Falstaff",
    "original": "E vi discaccio.",
    "cue_id": "a1_s1_c102",
    "line_id": "a1_s1_c102_l22"
  },
  {
    "speaker": "Sir John Falstaff",
    "original": "Olà! lesti! lesti! al galoppo!",
    "cue_id": "a1_s1_c104",
    "line_id": "a1_s1_c104_l1"
  },
  {
    "speaker": "Sir John Falstaff",
    "original": "al galoppo! Il capestro assai bene vi sta.",
    "cue_id": "a1_s1_c104",
    "line_id": "a1_s1_c104_l2"
  },
  {
    "speaker": "Sir John Falstaff",
    "original": "Ladri! Via! Via di qua! Via di qua! Via di qua!",
    "cue_id": "a1_s1_c104",
    "line_id": "a1_s1_c104_l3"
  }
]