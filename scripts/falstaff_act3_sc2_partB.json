[
  {
    "speaker": "Nannetta",
    "original": "Coi gigli e le vïole",
    "cue_id": "a3_s2_c52",
    "line_id": "a3_s2_c52_l5"
  },
  {
    "speaker": "Nannetta",
    "original": "scriviam dei nomi arcani,",
    "cue_id": "a3_s2_c52",
    "line_id": "a3_s2_c52_l6"
  },
  {
    "speaker": "Nannetta",
    "original": "dalle fatate mani",
    "cue_id": "a3_s2_c52",
    "line_id": "a3_s2_c52_l7"
  },
  {
    "speaker": "Nannetta",
    "original": "germoglino parole.",
    "cue_id": "a3_s2_c52",
    "line_id": "a3_s2_c52_l8"
  },
  {
    "speaker": "Nannetta",
    "original": "Parole alluminate",
    "cue_id": "a3_s2_c52",
    "line_id": "a3_s2_c52_l9"
  },
  {
    "speaker": "Nannetta",
    "original": "di puro argento e d'or,",
    "cue_id": "a3_s2_c52",
    "line_id": "a3_s2_c52_l10"
  },
  {
    "speaker": "Nannetta",
    "original": "carmi e malie. Le fate",
    "cue_id": "a3_s2_c52",
    "line_id": "a3_s2_c52_l11"
  },
  {
    "speaker": "Nannetta",
    "original": "hanno per cifre i fior.",
    "cue_id": "a3_s2_c52",
    "line_id": "a3_s2_c52_l12"
  },
  {
    "speaker": "Nannetta",
    "original": "Moviamo ad una ad una",
    "cue_id": "a3_s2_c53",
    "line_id": "a3_s2_c53_l1"
  },
  {
    "speaker": "Nannetta",
    "original": "sotto il lunare albor,",
    "cue_id": "a3_s2_c53",
    "line_id": "a3_s2_c53_l2"
  },
  {
    "speaker": "Nannetta",
    "original": "verso la quercia bruna",
    "cue_id": "a3_s2_c53",
    "line_id": "a3_s2_c53_l3"
  },
  {
    "speaker": "Nannetta",
    "original": "del nero cacciator.",
    "cue_id": "a3_s2_c53",
    "line_id": "a3_s2_c53_l4"
  },
  {
    "speaker": "Bardolfo",
    "original": "Alto là!",
    "cue_id": "a3_s2_c55",
    "line_id": "a3_s2_c55_l1"
  },
  {
    "speaker": "Pistola",
    "original": "Chi va là?",
    "cue_id": "a3_s2_c56",
    "line_id": "a3_s2_c56_l1"
  },
  {
    "speaker": "Sir John Falstaff",
    "original": "Pietà!",
    "cue_id": "a3_s2_c57",
    "line_id": "a3_s2_c57_l1"
  },
  {
    "speaker": "Mrs. Quickly",
    "original": "C'è un uom!",
    "cue_id": "a3_s2_c58",
    "line_id": "a3_s2_c58_l1"
  },
  {
    "speaker": "Mrs. Quickly",
    "original": "ALICE, MEG E NANNETTA",
    "cue_id": "a3_s2_c58",
    "line_id": "a3_s2_c58_l2"
  },
  {
    "speaker": "Ford",
    "original": "Cornuto come un bue!",
    "cue_id": "a3_s2_c59",
    "line_id": "a3_s2_c59_l1"
  },
  {
    "speaker": "Pistola",
    "original": "Rotondo come un pomo!",
    "cue_id": "a3_s2_c60",
    "line_id": "a3_s2_c60_l1"
  },
  {
    "speaker": "Bardolfo",
    "original": "Grosso come una nave!",
    "cue_id": "a3_s2_c61",
    "line_id": "a3_s2_c61_l1"
  },
  {
    "speaker": "Bardolfo",
    "original": "PISTOLA, BARDOLFO",
    "cue_id": "a3_s2_c61",
    "line_id": "a3_s2_c61_l2"
  },
  {
    "speaker": "Bardolfo",
    "original": "Alzati, olà!",
    "cue_id": "a3_s2_c62",
    "line_id": "a3_s2_c62_l1"
  },
  {
    "speaker": "Sir John Falstaff",
    "original": "Portatemi una grue!",
    "cue_id": "a3_s2_c63",
    "line_id": "a3_s2_c63_l1"
  },
  {
    "speaker": "Sir John Falstaff",
    "original": "Non posso.",
    "cue_id": "a3_s2_c63",
    "line_id": "a3_s2_c63_l2"
  },
  {
    "speaker": "Ford",
    "original": "È troppo grave.",
    "cue_id": "a3_s2_c64",
    "line_id": "a3_s2_c64_l1"
  },
  {
    "speaker": "Mrs. Quickly",
    "original": "È corrotto!",
    "cue_id": "a3_s2_c65",
    "line_id": "a3_s2_c65_l1"
  },
  {
    "speaker": "Alice, Meg & Nannetta",
    "original": "È impuro!",
    "cue_id": "a3_s2_c66",
    "line_id": "a3_s2_c66_l1"
  },
  {
    "speaker": "Bardolfo",
    "original": "Si faccia lo scongiuro!",
    "cue_id": "a3_s2_c68",
    "line_id": "a3_s2_c68_l1"
  },
  {
    "speaker": "Alice Ford",
    "original": "Evita il tuo periglio.",
    "cue_id": "a3_s2_c70",
    "line_id": "a3_s2_c70_l1"
  },
  {
    "speaker": "Alice Ford",
    "original": "Già il Dottor Cajo ti cerca.",
    "cue_id": "a3_s2_c70",
    "line_id": "a3_s2_c70_l2"
  },
  {
    "speaker": "Nannetta",
    "original": "Troviamo",
    "cue_id": "a3_s2_c71",
    "line_id": "a3_s2_c71_l1"
  },
  {
    "speaker": "Nannetta",
    "original": "un nascondiglio.",
    "cue_id": "a3_s2_c71",
    "line_id": "a3_s2_c71_l2"
  },
  {
    "speaker": "Mrs. Quickly",
    "original": "Poi tornerete lesti al mio richiamo.",
    "cue_id": "a3_s2_c73",
    "line_id": "a3_s2_c73_l1"
  },
  {
    "speaker": "Bardolfo",
    "original": "Spiritelli! Folletti!",
    "cue_id": "a3_s2_c74",
    "line_id": "a3_s2_c74_l1"
  },
  {
    "speaker": "Bardolfo",
    "original": "Farfarelli! Vampiri! Agili insetti",
    "cue_id": "a3_s2_c74",
    "line_id": "a3_s2_c74_l2"
  },
  {
    "speaker": "Bardolfo",
    "original": "del palude infernale! Punzecchiatelo!",
    "cue_id": "a3_s2_c74",
    "line_id": "a3_s2_c74_l3"
  },
  {
    "speaker": "Bardolfo",
    "original": "Orticheggiatelo!",
    "cue_id": "a3_s2_c74",
    "line_id": "a3_s2_c74_l4"
  },
  {
    "speaker": "Bardolfo",
    "original": "Martirizzatelo",
    "cue_id": "a3_s2_c74",
    "line_id": "a3_s2_c74_l5"
  },
  {
    "speaker": "Bardolfo",
    "original": "coi grifi aguzzi!",
    "cue_id": "a3_s2_c74",
    "line_id": "a3_s2_c74_l6"
  },
  {
    "speaker": "Bardolfo",
    "original": "Accorrono velocissimi alcuni ragazzi vestiti da folletti,",
    "cue_id": "a3_s2_c74",
    "line_id": "a3_s2_c74_l7"
  },
  {
    "speaker": "Bardolfo",
    "original": "e si scagliano su",
    "cue_id": "a3_s2_c74",
    "line_id": "a3_s2_c74_l8"
  },
  {
    "speaker": "Bardolfo",
    "original": "Falstaff.",
    "cue_id": "a3_s2_c74",
    "line_id": "a3_s2_c74_l9"
  },
  {
    "speaker": "Sir John Falstaff",
    "original": "Ahimè! tu puzzi",
    "cue_id": "a3_s2_c75",
    "line_id": "a3_s2_c75_l1"
  },
  {
    "speaker": "Sir John Falstaff",
    "original": "come una puzzola.",
    "cue_id": "a3_s2_c75",
    "line_id": "a3_s2_c75_l2"
  },
  {
    "speaker": "Sir John Falstaff",
    "original": "FOLLETTI E DIAVOLI",
    "cue_id": "a3_s2_c75",
    "line_id": "a3_s2_c75_l3"
  },
  {
    "speaker": "Sir John Falstaff",
    "original": "Ruzzola, ruzzola, ruzzola, ruzzola!",
    "cue_id": "a3_s2_c76",
    "line_id": "a3_s2_c76_l1"
  },
  {
    "speaker": "Alice, Quickly & Meg",
    "original": "Pizzica, pizzica,",
    "cue_id": "a3_s2_c77",
    "line_id": "a3_s2_c77_l1"
  },
  {
    "speaker": "Alice, Quickly & Meg",
    "original": "pizzica, stuzzica,",
    "cue_id": "a3_s2_c77",
    "line_id": "a3_s2_c77_l2"
  },
  {
    "speaker": "Alice, Quickly & Meg",
    "original": "spizzica, spizzica,",
    "cue_id": "a3_s2_c77",
    "line_id": "a3_s2_c77_l3"
  },
  {
    "speaker": "Alice, Quickly & Meg",
    "original": "pungi, spilluzzica,",
    "cue_id": "a3_s2_c77",
    "line_id": "a3_s2_c77_l4"
  },
  {
    "speaker": "Alice, Quickly & Meg",
    "original": "finch'egli abbai!",
    "cue_id": "a3_s2_c77",
    "line_id": "a3_s2_c77_l5"
  },
  {
    "speaker": "Sir John Falstaff",
    "original": "Ahi! Ahi! Ahi! Ahi!",
    "cue_id": "a3_s2_c78",
    "line_id": "a3_s2_c78_l1"
  },
  {
    "speaker": "Sir John Falstaff",
    "original": "FOLLETTI, DIAVOLI",
    "cue_id": "a3_s2_c78",
    "line_id": "a3_s2_c78_l2"
  },
  {
    "speaker": "Sir John Falstaff",
    "original": "Scrolliam crepitacoli,",
    "cue_id": "a3_s2_c78",
    "line_id": "a3_s2_c78_l3"
  },
  {
    "speaker": "Sir John Falstaff",
    "original": "scarandole e nacchere!",
    "cue_id": "a3_s2_c78",
    "line_id": "a3_s2_c78_l4"
  },
  {
    "speaker": "Sir John Falstaff",
    "original": "Di schizzi e di zacchere",
    "cue_id": "a3_s2_c78",
    "line_id": "a3_s2_c78_l5"
  },
  {
    "speaker": "Sir John Falstaff",
    "original": "quell'otre si macoli.",
    "cue_id": "a3_s2_c78",
    "line_id": "a3_s2_c78_l6"
  },
  {
    "speaker": "Sir John Falstaff",
    "original": "Meniam scorribandole,",
    "cue_id": "a3_s2_c78",
    "line_id": "a3_s2_c78_l7"
  },
  {
    "speaker": "Sir John Falstaff",
    "original": "danziamo la tresca,",
    "cue_id": "a3_s2_c78",
    "line_id": "a3_s2_c78_l8"
  },
  {
    "speaker": "Sir John Falstaff",
    "original": "treschiam le farandole",
    "cue_id": "a3_s2_c78",
    "line_id": "a3_s2_c78_l9"
  },
  {
    "speaker": "Sir John Falstaff",
    "original": "sull'ampia ventresca.",
    "cue_id": "a3_s2_c78",
    "line_id": "a3_s2_c78_l10"
  },
  {
    "speaker": "Sir John Falstaff",
    "original": "Zanzare ed assilli,",
    "cue_id": "a3_s2_c78",
    "line_id": "a3_s2_c78_l11"
  },
  {
    "speaker": "Sir John Falstaff",
    "original": "volate alla lizza",
    "cue_id": "a3_s2_c78",
    "line_id": "a3_s2_c78_l12"
  },
  {
    "speaker": "Sir John Falstaff",
    "original": "coi dardi e gli spilli!",
    "cue_id": "a3_s2_c78",
    "line_id": "a3_s2_c78_l13"
  },
  {
    "speaker": "Sir John Falstaff",
    "original": "Ch'ei crepi di stizza!",
    "cue_id": "a3_s2_c78",
    "line_id": "a3_s2_c78_l14"
  },
  {
    "speaker": "Alice, Meg & Quickly",
    "original": "pungi, spilluzzica",
    "cue_id": "a3_s2_c79",
    "line_id": "a3_s2_c79_l4"
  },
  {
    "speaker": "Sir John Falstaff",
    "original": "ALICE, MEG, QUICKLY E FATE",
    "cue_id": "a3_s2_c80",
    "line_id": "a3_s2_c80_l2"
  },
  {
    "speaker": "Sir John Falstaff",
    "original": "Cozzalo, aizzalo",
    "cue_id": "a3_s2_c80",
    "line_id": "a3_s2_c80_l3"
  },
  {
    "speaker": "Sir John Falstaff",
    "original": "dai piè al cocuzzolo!",
    "cue_id": "a3_s2_c80",
    "line_id": "a3_s2_c80_l4"
  },
  {
    "speaker": "Sir John Falstaff",
    "original": "Strozzalo, strizzalo!",
    "cue_id": "a3_s2_c80",
    "line_id": "a3_s2_c80_l5"
  },
  {
    "speaker": "Sir John Falstaff",
    "original": "Gli svampi l'uzzolo!",
    "cue_id": "a3_s2_c80",
    "line_id": "a3_s2_c80_l6"
  },
  {
    "speaker": "Sir John Falstaff",
    "original": "Pizzica, pizzica, l'unghia rintuzzola!",
    "cue_id": "a3_s2_c80",
    "line_id": "a3_s2_c80_l7"
  },
  {
    "speaker": "Sir John Falstaff",
    "original": "DR. CAJUS E FORD",
    "cue_id": "a3_s2_c81",
    "line_id": "a3_s2_c81_l1"
  },
  {
    "speaker": "Sir John Falstaff",
    "original": "Cialtron!",
    "cue_id": "a3_s2_c81",
    "line_id": "a3_s2_c81_l2"
  },
  {
    "speaker": "Bardolfo & Pistola",
    "original": "Poltron!",
    "cue_id": "a3_s2_c82",
    "line_id": "a3_s2_c82_l1"
  },
  {
    "speaker": "Bardolfo & Pistola",
    "original": "Ghiotton!",
    "cue_id": "a3_s2_c82",
    "line_id": "a3_s2_c82_l2"
  },
  {
    "speaker": "Bardolfo & Pistola",
    "original": "TUTTI GLI UOMINI",
    "cue_id": "a3_s2_c82",
    "line_id": "a3_s2_c82_l3"
  },
  {
    "speaker": "Bardolfo & Pistola",
    "original": "Pancion!",
    "cue_id": "a3_s2_c82",
    "line_id": "a3_s2_c82_l4"
  },
  {
    "speaker": "Bardolfo & Pistola",
    "original": "Beon!",
    "cue_id": "a3_s2_c82",
    "line_id": "a3_s2_c82_l5"
  },
  {
    "speaker": "Bardolfo & Pistola",
    "original": "Briccon!",
    "cue_id": "a3_s2_c82",
    "line_id": "a3_s2_c82_l6"
  },
  {
    "speaker": "Bardolfo & Pistola",
    "original": "In ginocchion!",
    "cue_id": "a3_s2_c82",
    "line_id": "a3_s2_c82_l7"
  },
  {
    "speaker": "Ford",
    "original": "Pancia ritronfia!",
    "cue_id": "a3_s2_c84",
    "line_id": "a3_s2_c84_l1"
  },
  {
    "speaker": "Alice Ford",
    "original": "Guancia rigonfia!",
    "cue_id": "a3_s2_c85",
    "line_id": "a3_s2_c85_l1"
  },
  {
    "speaker": "Bardolfo",
    "original": "Sconquassaletti!",
    "cue_id": "a3_s2_c86",
    "line_id": "a3_s2_c86_l1"
  },
  {
    "speaker": "Mrs. Quickly",
    "original": "Spaccafarsetti!",
    "cue_id": "a3_s2_c87",
    "line_id": "a3_s2_c87_l1"
  },
  {
    "speaker": "Pistola",
    "original": "Vuotabarili!",
    "cue_id": "a3_s2_c88",
    "line_id": "a3_s2_c88_l1"
  },
  {
    "speaker": "Dr. Caius",
    "original": "Sfiancagiumenti!",
    "cue_id": "a3_s2_c89",
    "line_id": "a3_s2_c89_l1"
  },
  {
    "speaker": "Ford",
    "original": "Triplice mento!",
    "cue_id": "a3_s2_c90",
    "line_id": "a3_s2_c90_l1"
  },
  {
    "speaker": "Bardolfo & Pistola",
    "original": "Di' che ti penti!",
    "cue_id": "a3_s2_c91",
    "line_id": "a3_s2_c91_l1"
  },
  {
    "speaker": "Sir John Falstaff",
    "original": "Ahi! Ahi! mi pento!",
    "cue_id": "a3_s2_c93",
    "line_id": "a3_s2_c93_l1"
  },
  {
    "speaker": "Sir John Falstaff",
    "original": "Uom frodolento!",
    "cue_id": "a3_s2_c93",
    "line_id": "a3_s2_c93_l3"
  },
  {
    "speaker": "Sir John Falstaff",
    "original": "GLI UOMINI",
    "cue_id": "a3_s2_c94",
    "line_id": "a3_s2_c94_l2"
  },
  {
    "speaker": "Sir John Falstaff",
    "original": "Uom turbolento!",
    "cue_id": "a3_s2_c94",
    "line_id": "a3_s2_c94_l3"
  },
  {
    "speaker": "Sir John Falstaff",
    "original": "Capron!",
    "cue_id": "a3_s2_c95",
    "line_id": "a3_s2_c95_l3"
  },
  {
    "speaker": "Sir John Falstaff",
    "original": "Scroccon!",
    "cue_id": "a3_s2_c95",
    "line_id": "a3_s2_c95_l4"
  },
  {
    "speaker": "Sir John Falstaff",
    "original": "Spaccon!",
    "cue_id": "a3_s2_c95",
    "line_id": "a3_s2_c95_l5"
  },
  {
    "speaker": "Sir John Falstaff",
    "original": "Perdon!",
    "cue_id": "a3_s2_c96",
    "line_id": "a3_s2_c96_l1"
  },
  {
    "speaker": "Bardolfo",
    "original": "Riforma la tua vita!",
    "cue_id": "a3_s2_c97",
    "line_id": "a3_s2_c97_l1"
  },
  {
    "speaker": "Sir John Falstaff",
    "original": "Tu puti d'acquavita.",
    "cue_id": "a3_s2_c98",
    "line_id": "a3_s2_c98_l1"
  },
  {
    "speaker": "Sir John Falstaff",
    "original": "LE DONNE",
    "cue_id": "a3_s2_c98",
    "line_id": "a3_s2_c98_l2"
  },
  {
    "speaker": "Sir John Falstaff",
    "original": "Domine fallo casto!",
    "cue_id": "a3_s2_c98",
    "line_id": "a3_s2_c98_l3"
  },
  {
    "speaker": "Sir John Falstaff",
    "original": "Ma salvagli l'addomine.",
    "cue_id": "a3_s2_c99",
    "line_id": "a3_s2_c99_l1"
  },
  {
    "speaker": "Sir John Falstaff",
    "original": "Domine fallo guasto!",
    "cue_id": "a3_s2_c99",
    "line_id": "a3_s2_c99_l3"
  },
  {
    "speaker": "Sir John Falstaff",
    "original": "Fallo punito domine!",
    "cue_id": "a3_s2_c100",
    "line_id": "a3_s2_c100_l3"
  },
  {
    "speaker": "Sir John Falstaff",
    "original": "Fallo pentito domine!",
    "cue_id": "a3_s2_c101",
    "line_id": "a3_s2_c101_l3"
  },
  {
    "speaker": "The Men",
    "original": "Globo d'impurità, rispondi.",
    "cue_id": "a3_s2_c103",
    "line_id": "a3_s2_c103_l1"
  },
  {
    "speaker": "Sir John Falstaff",
    "original": "Ben mi sta.",
    "cue_id": "a3_s2_c104",
    "line_id": "a3_s2_c104_l1"
  },
  {
    "speaker": "The Men",
    "original": "Monte d'obesità, rispondi.",
    "cue_id": "a3_s2_c105",
    "line_id": "a3_s2_c105_l1"
  },
